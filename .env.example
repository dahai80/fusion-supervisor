# fusion-supervisor production sidecar env — copy to .env (git-ignored) and fill.
# Ports below respect architecture/port-registry.yaml: sidecar middleware uses
# standard reserved ports (5432/6379/6333/80/443/8080), none collide with the
# 41 fusion service ports (11xxx range).
# Secret placeholders follow architecture/config-conventions.md §4: they are
# acquisition guidance, never fake usable keys ("fg-admin-key" 401 lesson).

# --- required ---
# Set your own strong password; consumed by Postgres + pg-init + env_map injection.
FUSION_PG_PASSWORD=change-me-to-a-strong-password
# Client key for the fusion gateway. Obtain the real value from the gateway
# admin API (see architecture/config-conventions.md §2) — never ship a key here.
# Canonical name since config Phase 3 (issue #74); legacy FUSION_MLX_API_KEY is
# resolved by the fusion-core alias chain, this repo consumes only this name.
FUSION_CLIENT_KEY=obtain-via-gateway-admin-api

# --- optional: sidecar middleware ---
FUSION_PG_USER=fusion
FUSION_PG_DB=fusion
# extra DBs created at first boot (cowork/identity/rag default)
FUSION_PG_DATABASES=cowork,identity,rag,modelhub
FUSION_REDIS_MAXMEMORY=256mb
FUSION_LOG_LEVEL=INFO

# --- optional: Traefik / TLS ---
FUSION_DOMAIN=fusion.local
FUSION_ACME_EMAIL=admin@fusion.local

# --- optional: business-plane DB names (must exist in FUSION_PG_DATABASES) ---
FUSION_MODELHUB_DB=modelhub
FUSION_COWORK_DB=cowork

# --- optional: native core attach ---
# MLX + fusion-gateway run bare-metal on the host; containers reach them via:
FUSION_MLX_URL=http://host.docker.internal:11434
FUSION_GATEWAY_URL=http://host.docker.internal:11432

# --- optional: nightly backup target (§5.4 NAS) ---
# FUSION_BACKUP_TARGET=//nas/fusion-backups
